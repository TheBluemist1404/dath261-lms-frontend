{
	"name": "dath261-lms-frontend",
	"private": true,
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=22.12.0"
	},
	"type": "module",
	"scripts": {
		"dev": "vite --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"ci": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc,css,html}": "biome check --write"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "^5.103.1",
		"@tanstack/react-router": "^1.170.38",
		"axios": "^1.19.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.2",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.12",
		"@tanstack/react-query-devtools": "^5.103.1",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.40",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"husky": "^9.1.7",
		"jsdom": "^30.1.0",
		"lint-staged": "^17.5.1",
		"msw": "^2.15.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.1"
	}
}
