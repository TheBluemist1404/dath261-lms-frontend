VITE_API_BASE_URL=/api
# Development only: where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:3001
# Development only: "true" serves the API from MSW mocks in the browser.
VITE_API_MOCKING=false
# Optional: collaboration WebSocket URL. Defaults to <VITE_API_BASE_URL>/collab on this host.
# VITE_COLLAB_URL=wss://api.example.com/api/collab
